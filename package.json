{
  "name": "tree-sitter-solidity",
  "version": "1.2.11",
  "description": "A tree sitter parser for Solidity",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "test": "tree-sitter generate && tree-sitter test",
    "test:predicates": "mocha test/predicate-tests.js",
    "test:highlights": "node scripts/test-highlights.js",
    "test:highlights:native": "tree-sitter test --highlight test/highlight/*.sol",
    "test:all": "npm test && npm run test:predicates && npm run test:highlights",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "author": "Joran Honig",
  "license": "MIT",
  "dependencies": {
    "yarn": "^1.22.21",
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.24.4",
    "prebuildify": "^6.0.0",
    "mocha": "^10.0.0"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "docs/CUSTOM_PREDICATES.md",
    "examples/custom-predicates-example.js"
  ]
}
